  "split": "smoke",
  "slam": {
    "command": ["python", "scripts/run_wp2_pyslam.py", "--pyslam-root", "external/pyslam", "--pyslam-python", ".venv-pyslam/bin/python", "--frames", "200", "--export-sparse"]
  },
  "geometry": {
    "command": ["python", "scripts/run_tum_da3_metric.py", "--frames", "200", "--warmup", "1"]
  },
  "mapping": {"plot": true},
  "comparison": {"keyframe_intervals": [2, 5]},
  "timeout_s": 3600
}
